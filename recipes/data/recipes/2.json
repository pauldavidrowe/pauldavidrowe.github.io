      ],
      "ingredients_used": [],
      "timing": "jit"
    },
    {
      "id": 141,
      "position": 13,
      "raw_text": "Continue to drizzle more pasta water in and mash until the cheese becomes a soft paste. You might not need the full 1/2 cup, but make sure the cheese paste isn't dry, or it will be harder to toss with the spaghetti.",
      "category": "cook",
      "attention": "occasional",
      "time_min": 3.0,
      "time_source": "estimated",
      "equipment": "medium heatproof bowl, fork",
      "image_url": null,
