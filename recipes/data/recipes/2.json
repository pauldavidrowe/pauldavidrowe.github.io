        "1 to 2 tablespoons pasta water",
        "4 ounces grated Pecorino Romano cheese"
      ],
      "timing": "jit"
    },
    {
      "id": 140,
      "position": 12,
      "raw_text": "Cook, tossing often, until the pasta is well-coated and there is very little cooking water left in the skillet, 2 to 3 minutes.",
      "category": "cook",
      "attention": "occasional",
      "time_min": 2.5,
      "time_source": "recipe_stated",
      "equipment": "large skillet",
      "image_url": null,
