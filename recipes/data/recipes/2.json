      ],
      "timing": "jit"
    },
    {
      "id": 139,
      "position": 11,
      "raw_text": "Drizzle 1 to 2 tablespoons of the pasta water into the bowl of grated cheese and start mashing with a fork to evenly moisten it.",
      "category": "cook",
      "attention": "hands_on",
      "time_min": 2.0,
      "time_source": "estimated",
      "equipment": "medium heatproof bowl, fork",
      "image_url": null,
