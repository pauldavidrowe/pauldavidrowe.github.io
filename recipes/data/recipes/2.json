        "cheese mixture"
      ],
      "timing": "jit"
    },
    {
      "id": 142,
      "position": 14,
      "raw_text": "Turn the heat off.",
      "category": "cook",
      "attention": "hands_on",
      "time_min": 1.0,
      "time_source": "estimated",
      "equipment": "large skillet",
      "image_url": null,
