      ],
      "ingredients_used": [],
      "timing": "jit"
    },
    {
      "id": 133,
      "position": 5,
      "raw_text": "Let the peppercorns cool, then coarsely crush 1 1/2 teaspoons with a mortar and pestle or under a heavy pan on a cutting board, or coarsely grind in a spice grinder.",
      "category": "prep",
      "attention": "hands_on",
      "time_min": 3.0,
      "time_source": "estimated",
      "equipment": null,
      "image_url": null,
      "deps": [
