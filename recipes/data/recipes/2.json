        "pasta water as needed"
      ],
      "timing": "jit"
    },
    {
      "id": 145,
      "position": 17,
      "raw_text": "Once all the cheese paste has been tossed in and the noodles are glossy and coated, add pasta water in 1/4-cup increments, tossing between each, until the noodles are lightly sauced and well-coated but not runny.",
      "category": "cook",
      "attention": "hands_on",
      "time_min": 3.0,
      "time_source": "estimated",
      "equipment": "large skillet, tongs",
      "image_url": null,
      "deps": [
