      ],
      "timing": "jit"
    },
    {
      "id": 131,
      "position": 3,
      "raw_text": "Add 1 pound dry spaghetti and a few pinches kosher salt to the boiling water and cook according to package directions until just al dente, 8 to 10 minutes.",
      "category": "cook",
      "attention": "hands_free",
      "time_min": 9.0,
